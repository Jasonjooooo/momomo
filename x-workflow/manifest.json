{
  "manifest_version": 3,
  "name": "X 时间工作流",
  "short_name": "时间工作流",
  "version": "1.6.0",
  "description": "把一天的 X 运营排成时间线：发帖计划从「回关助手」的发帖排期表实时同步，互关池、X 自动回复流程也接在一起；步骤可以自己加、改、删，可以设重复动作，到点提醒。",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "打开时间工作流" },
  "background": { "service_worker": "bg.js" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1:38719/*"],
  "minimum_chrome_version": "116"
}
